{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml"
        ]
      },
      {
        "src": "guides",
        "dest": "guides",
        "files": [
          "toc.yml",
          "installation.md",
          "getting-started.md",
          "troubleshooting.md",
          "security.md"
        ]
      },
      {
        "src": "api",
        "dest": "api",
        "files": [
          "toc.yml",
          "reference.md"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/material",
      "templates/site"
    ],
    "globalMetadata": {
      "_appName": "S1Lua",
      "_appTitle": "S1Lua Documentation",
      "_appFooter": "S1Lua — a beginner-friendly Lua layer for S1API.",
      "_enableSearch": true,
      "_navbarTitle": "S1Lua"
    },
    "sitemap": {
      "baseUrl": "https://ifbars.github.io/S1Lua/"
    }
  }
}
